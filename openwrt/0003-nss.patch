diff --git a/package/kernel/qca-ssdk/Makefile b/package/kernel/qca-ssdk/Makefile
index a5588d5032..d64c8ffdcd 100644
--- a/package/kernel/qca-ssdk/Makefile
+++ b/package/kernel/qca-ssdk/Makefile
@@ -21,7 +21,7 @@ define KernelPackage/qca-ssdk
   CATEGORY:=Kernel modules
   SUBMENU:=Network Devices
   TITLE:=Qualcom SSDK switch driver
-  DEPENDS:=@(TARGET_qualcommax)
+  DEPENDS:=@(TARGET_qualcommax) +kmod-swconfig
   FILES:=$(PKG_BUILD_DIR)/qca-ssdk.ko
   AUTOLOAD:=$(call AutoLoad,30,qca-ssdk)
 endef
@@ -34,11 +34,48 @@ GCC_VERSION=$(shell echo "$(CONFIG_GCC_VERSION)" | sed 's/[^0-9.]*\([0-9.]*\).*/
 
 LNX_CONFIG_OPTS = LNX_MAKEOPTS='$(KERNEL_MAKEOPTS)' PRJ_PATH=$(PKG_BUILD_DIR) MODULE_TYPE=KSLIB modules
 
+# OpenWrt backports upstream v6.16's two-argument .match_phy_device into
+# kernel 6.12, so LINUX_VERSION_CODE cannot tell the two prototypes apart.
+# Ask the kernel tree we are actually building against.  The grep pattern
+# must contain no parentheses: make counts them inside $(shell ...), and a
+# stray ')' closes the call early and leaks the rest into EXTRA_CFLAGS.
+SSDK_MATCH_PHY_DRV := $(shell grep -q 'match_phy_device.*phydev,' \
+	$(LINUX_DIR)/include/linux/phy.h 2>/dev/null && echo -DSSDK_MATCH_PHY_DEVICE_HAS_DRV)
+
 EXTRA_CFLAGS:= \
 	-fno-stack-protector \
 	-Wno-missing-prototypes \
 	-Wno-missing-declarations \
-	-I$(STAGING_DIR)/usr/include
+	-I$(STAGING_DIR)/usr/include \
+	$(SSDK_MATCH_PHY_DRV)
+
+# Per-subtarget SSDK feature selection.
+#
+# Upstream hard-disables every chip/PHY driver on the make command line,
+# which overrides ssdk's own ./config (a command-line variable always wins).
+# On ipq50xx that leaves qca-ssdk.ko with zero ISISC symbols, so it cannot
+# drive an external QCA8337 at all - boards like cmcc,pz-l8 were forced onto
+# the mainline qca8k DSA driver, whose 2-byte tag the NSS firmware cannot
+# parse.  Re-enable what ssdk's own config would have selected for MP:
+#   ISISC_ENABLE     - AR8327/AR8337 (QCA8337) chip driver
+#   SWCONFIG_FEATURE - swconfig/UCI front end (config switch / switch_vlan)
+#
+# The PHY drivers stay at their upstream FALSE: this board only needs ssdk
+# for the *external* QCA8337, and enabling IN_MP_PHY / IN_QCA803X_PHY /
+# IN_QCA808X_PHY makes ssdk register phylib drivers that compete with the
+# mainline IPQ5018 GE PHY and qca83xx drivers for the same phy_devices.
+# (IN_MP_PHY also implies IN_QCA808X_PHY, because src/hsl/phy/mpge_phy.c
+# and mpge_led.c call qca808x_phy_* directly - see the qca808x patch.)
+SSDK_SWCONFIG = disable
+SSDK_ISISC = disable
+SSDK_MP_PHY = FALSE
+SSDK_QCA803X_PHY = FALSE
+SSDK_QCA808X_PHY = FALSE
+
+ifeq ($(CONFIG_TARGET_SUBTARGET), "ipq50xx")
+  SSDK_SWCONFIG = enable
+  SSDK_ISISC = enable
+endif
 
 MAKE_FLAGS+= \
 	TARGET_NAME=$(CONFIG_TARGET_NAME) \
@@ -52,10 +89,10 @@ MAKE_FLAGS+= \
 	EXTRA_CFLAGS="$(EXTRA_CFLAGS)" \
 	SoC=$(CONFIG_TARGET_SUBTARGET) \
 	SHELL="$(BASH)" \
-	PTP_FEATURE=disable SWCONFIG_FEATURE=disable \
-	ISISC_ENABLE=disable MHT_ENABLE=disable \
-	IN_QCA803X_PHY=FALSE IN_QCA808X_PHY=FALSE \
-	IN_MALIBU_PHY=FALSE IN_MP_PHY=FALSE \
+	PTP_FEATURE=disable SWCONFIG_FEATURE=$(SSDK_SWCONFIG) \
+	ISISC_ENABLE=$(SSDK_ISISC) MHT_ENABLE=disable \
+	IN_QCA803X_PHY=$(SSDK_QCA803X_PHY) IN_QCA808X_PHY=$(SSDK_QCA808X_PHY) \
+	IN_MALIBU_PHY=FALSE IN_MP_PHY=$(SSDK_MP_PHY) \
 	$(LNX_CONFIG_OPTS)
 
 ifeq ($(CONFIG_TARGET_SUBTARGET), "ipq807x")
