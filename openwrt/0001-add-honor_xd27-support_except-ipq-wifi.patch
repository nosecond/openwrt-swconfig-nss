+		ath11k-firmware-ipq5018-qcn6122 \
+		ipq-wifi-honor_xd27
+endef
+TARGET_DEVICES += honor_xd27
+
 define Device/iodata_wn-dax3000gr
 	$(call Device/FitImageLzma)
 	DEVICE_VENDOR := I-O DATA
