+static void ath11k_mac_nss_tx_wake_work(struct work_struct *work)
+{
+	struct ath11k *ar = container_of(work, struct ath11k,
+					 nss_tx_wake_work.work);
+
+	ieee80211_wake_queues(ar->hw);
+}
+
+static bool ath11k_mac_tx_rings_have_space(struct ath11k_base *ab,
+					   struct sk_buff *skb)
+{
+	struct hal_srng *tcl_ring;
+	u32 ring_selector;
+	u8 primary_id, i;
+	int num_free;
+
+	ring_selector = ab->hw_params.hw_ops->get_ring_selector(skb);
+	primary_id = ring_selector % ab->hw_params.max_tx_ring;
+
+	tcl_ring = &ab->hal.srng_list[ab->dp.tx_ring[primary_id].tcl_data_ring.ring_id];
+	spin_lock_bh(&tcl_ring->lock);
+	num_free = ath11k_hal_srng_src_num_free(ab, tcl_ring, true);
+	spin_unlock_bh(&tcl_ring->lock);
+
+	if (num_free > 0)
+		return true;
+
+	if (!ab->hw_params.tcl_ring_retry)
+		return false;
+
+	for (i = 0; i < ab->hw_params.max_tx_ring; i++) {
+		if (i == primary_id)
+			continue;
+
+		tcl_ring = &ab->hal.srng_list[ab->dp.tx_ring[i].tcl_data_ring.ring_id];
+		spin_lock_bh(&tcl_ring->lock);
+		num_free = ath11k_hal_srng_src_num_free(ab, tcl_ring, true);
+		spin_unlock_bh(&tcl_ring->lock);
+
+		if (num_free > 0)
+			return true;
+	}
+
+	return false;
+}
